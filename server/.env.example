# Copy to .env and fill in real values. Never commit the real .env file.
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
# Set BMG_DATABASE_DRIVER=postgres and provide a Neon-compatible pooled URL to use PostgreSQL.
# Leave both unset to keep local SQLite development.
BMG_DATABASE_DRIVER=
DATABASE_URL=
PG_POOL_MAX=3
# Set PGSSL=disable only for a local PostgreSQL instance without TLS.
PGSSL=
ADMIN_EMAIL=admin@mip.com
ADMIN_PASSWORD=set-a-strong-password-here
# Comma-separated origins allowed to call the API from a separate local frontend.
FRONTEND_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501
